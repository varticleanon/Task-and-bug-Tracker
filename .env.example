# Application Environment
APP_ENV=production
HTTP_ADDR=:8080
APP_PUBLIC_URL=https://localhost

# File Storage Configuration
UPLOAD_DIR=/var/lib/task-bug-tracker/attachments
UPLOAD_MAX_BYTES=5242880

# Mounted Secret Paths (Production Secrets)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NAME="System Administrator"
SUPERADMIN_PASSWORD_FILE=./secrets/superadmin_password.txt
CSRF_HMAC_SECRET_FILE=./secrets/csrf_secret.txt
DATABASE_URL_FILE=./secrets/db_url.txt

# -----------------------------------------------------------------------------
# Docker Compose (docker-compose.yml)
# Nilai di bawah dipakai compose sebagai default bila tidak diset di environment.
# -----------------------------------------------------------------------------
DB_NAME=task_bug_tracker
DB_USER=tracker_user
DB_PASSWORD=SecurePassword123!
DB_HOST=db
WEB_PORT=80
SUPERADMIN_PASSWORD=SuperAdminPassword123!
CSRF_HMAC_SECRET=change-me-in-production-please
